# ---- Trading mode ----------------------------------------------------------
# BACKTEST | PAPER | LIVE   (default PAPER)
TRADING_MODE=PAPER
# Required in addition to TRADING_MODE=LIVE, or the app refuses to start.
LIVE_TRADING_CONFIRM=

MARKET_TIMEZONE=Asia/Kolkata

# ---- Market data -----------------------------------------------------------
# simulated | fyers
MARKET_DATA_PROVIDER=simulated
# Simulator streams outside market hours too (session state is still reported truthfully).
SIM_IGNORE_SESSION=true
SIM_SEED=
SIM_TICK_INTERVAL_SECONDS=1.0
# Probability per tick-cycle of a simulated disconnect (exercises reconnect logic).
SIM_DISCONNECT_PROBABILITY=0.0
# Minutes of synthetic candle history generated for SIM:* instruments when none exist (0 = off).
SIM_BACKFILL_MINUTES=375

# ---- Storage ---------------------------------------------------------------
# Local default (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./data/trader.db
# With docker compose:
# DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trader
# Only ticks for options within ATM +/- N strikes are stored; full chain is snapshotted.
TICK_STORE_STRIKE_WINDOW=3
OPTION_SNAPSHOT_INTERVAL_SECONDS=60

# Optional in V1 (in-process bus is used when empty)
REDIS_URL=

# ---- Broker: Fyers (market data, PRD §15/§17) -- never commit real values ----
# Create an app at https://myapi.fyers.in (type: individual). Set its redirect URL to
# FYERS_REDIRECT_URI exactly. Then, each trading day: python -m trader.brokers.fyers.login
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8765/fyers/callback
# Standard plan: 100 socket symbols, 10 expired-intraday calls/day. Prime: 5000 symbols, no expired quota.
FYERS_MAX_SYMBOLS=100
FYERS_STRIKES_EACH_SIDE=10
FYERS_EXPIRIES_PER_UNDERLYING=1
FYERS_EXPIRED_INTRADAY_DAILY_LIMIT=10
# Days of index/futures candles to gap-fill from Fyers history on API start-up.
HISTORY_BACKFILL_DAYS=5

# ---- Natural-language strategy builder (PRD §19) -----------------------------
# Optional. Without it, strategies can still be built and edited as forms/JSON.
ANTHROPIC_API_KEY=
STRATEGY_TRANSLATOR_MODEL=claude-opus-5-5

# ---- Broker: Shoonya (Finvasia) -- unused stub, kept for reference ----------
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=

# ---- Risk limits (enforced from Phase 10) ----------------------------------
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_TRADES_PER_DAY=5
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_LOTS_PER_TRADE=1

# ---- Options analytics -----------------------------------------------------
RISK_FREE_RATE=0.065

# ---- API -------------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
