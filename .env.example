# ---- Trading mode ----------------------------------------------------------
# BACKTEST | PAPER | LIVE   (default PAPER)
TRADING_MODE=PAPER
# Required in addition to TRADING_MODE=LIVE, or the app refuses to start.
LIVE_TRADING_CONFIRM=

MARKET_TIMEZONE=Asia/Kolkata

# ---- Market data -----------------------------------------------------------
# simulated | fyers
MARKET_DATA_PROVIDER=simulated
# Simulator streams outside market hours too (session state is still reported truthfully).
SIM_IGNORE_SESSION=true
SIM_SEED=
SIM_TICK_INTERVAL_SECONDS=1.0
# Probability per tick-cycle of a simulated disconnect (exercises reconnect logic).
SIM_DISCONNECT_PROBABILITY=0.0
# Minutes of synthetic candle history generated for SIM:* instruments when none exist (0 = off).
SIM_BACKFILL_MINUTES=375

# ---- Storage ---------------------------------------------------------------
# Local default (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./data/trader.db
# With docker compose:
# DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trader
# Only ticks for options within ATM +/- N strikes are stored; full chain is snapshotted.
TICK_STORE_STRIKE_WINDOW=3
OPTION_SNAPSHOT_INTERVAL_SECONDS=60

# Optional in V1 (in-process bus is used when empty)
REDIS_URL=

# ---- Broker: Fyers (market data, PRD §15/§17) -- never commit real values ----
# Create an app at https://myapi.fyers.in (type: individual). Set its redirect URL to
# FYERS_REDIRECT_URI exactly. Then, each trading day: python -m trader.brokers.fyers.login
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8765/fyers/callback
# Standard plan: 100 socket symbols, 10 expired-intraday calls/day. Prime: 5000 symbols, no expired quota.
FYERS_MAX_SYMBOLS=100
FYERS_STRIKES_EACH_SIDE=10
FYERS_EXPIRIES_PER_UNDERLYING=1
FYERS_EXPIRED_INTRADAY_DAILY_LIMIT=10
# Days of index/futures candles to gap-fill from Fyers history on API start-up.
HISTORY_BACKFILL_DAYS=5

# ---- Natural-language strategy builder (PRD §19) -----------------------------
# Optional. Without it, strategies can still be built and edited as forms/JSON.
# Which LLM translates: anthropic (default) | openrouter | groq | openai | custom (any OpenAI-compatible server).
LLM_PROVIDER=anthropic
LLM_MODEL=                     # empty = the provider's default
LLM_BASE_URL=                  # only for custom (e.g. http://localhost:11434/v1 for Ollama)
LLM_API_KEY=                   # optional; overrides the provider-specific key below
# Tried in order if the main provider fails (rate limit, outage, bad key). Entries: provider or provider:model.
# A fallback only counts if its own key is set.
LLM_FALLBACKS=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Only allow OpenRouter's free models (ids ending in :free), so a test run can never spend credits.
OPENROUTER_FREE_ONLY=true
# If an OpenRouter model fails or is rate limited, try up to this many OTHER free models (found automatically).
OPENROUTER_FREE_POOL=4
GROQ_API_KEY=
OPENAI_API_KEY=
STRATEGY_TRANSLATOR_MODEL=claude-opus-5-5   # the Anthropic default when LLM_MODEL is empty

# ---- Voice input for the strategy box (Deepgram speech-to-text) -------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-IN

# ---- Broker: Shoonya (Finvasia) -- unused stub, kept for reference ----------
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=

# ---- Risk limits (enforced from Phase 10) ----------------------------------
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_TRADES_PER_DAY=5
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_LOTS_PER_TRADE=1

# ---- Options analytics -----------------------------------------------------
RISK_FREE_RATE=0.065

# ---- API -------------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- SaaS (docs/pricing-and-saas.md). Leave AUTH_ENABLED=false for the local single-user mode (no login, no limits) ----
AUTH_ENABLED=false
CREDENTIAL_KEY=               # encrypts customers' broker keys: python -m trader.scripts.accounts gen-key
STORE_TICKS=true              # false on a small hosted database (raw ticks are ~600k rows a day)
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false      # true behind HTTPS
SIGNUP_OPEN=true
SIGNUP_INVITE_CODE=           # set a code to make sign-up invite-only
# Google sign-in: the Web client id from Google Cloud Console > APIs & Services > Credentials (not secret). Empty = no button.
# Public address of the site; broker sign-ins send the browser back here (empty = the request's own host)
PUBLIC_URL=
GOOGLE_CLIENT_ID=
# Phone OTP: SMS_PROVIDER= (off) | console (prints the code in the server log: local testing only) | twilio
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ADMIN_EMAILS=                 # comma list: unlimited plan, Paper tab, grant plans
# Razorpay subscriptions: create monthly INR plans in the dashboard, paste their ids. Webhook URL: /api/billing/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_MAX=
